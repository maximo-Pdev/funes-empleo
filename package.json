    "test:e2e:full": "node tests/quality/run-local-e2e.mjs --confirm-local-reset",
    "acceptance:reset-demo": "node tests/fixtures/reset-demo.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
