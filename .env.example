# Solo entorno local ficticio. Completar localmente; nunca compartir secretos.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_CLAVE_PUBLICABLE_LOCAL
# Opcional: exclusivamente aprovisionamiento/operaciones privilegiadas autorizadas.
SUPABASE_SECRET_KEY=
# Identificador demo no secreto; el reset alojado está bloqueado (EXTRA-015).
ACCEPTANCE_DEMO_PROJECT_REF=
# Solo scripts Node alojados; valores privados por rol, sin defaults.
# Cada identidad ficticia del seed usa la contraseña de su rol (admin/candidate/company).
# No usar prefijo NEXT_PUBLIC ni copiar estos valores a fixtures/logs/chat.
# Consultar docs/operations/demo-credentials.md. No necesarios para E2E local.
DEMO_ADMIN_PASSWORD=
DEMO_CANDIDATE_PASSWORD=
DEMO_COMPANY_PASSWORD=
# Texto ficticio de desarrollo, NO consentimiento municipal aprobado.
CONSENT_POLICY_VERSION=demo-not-approved
# Solo pruebas de recuperación con el buzón ficticio local; no SMTP productivo.
LOCAL_MAILPIT_URL=http://127.0.0.1:54324
# Opcional solo para E2E con un servidor de prueba ya iniciado deliberadamente.
# PLAYWRIGHT_EXTERNAL_SERVER=1
